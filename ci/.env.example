# Copy to ci/.env and fill in. ci/.env is ignored by Git.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me

# Generated in SonarQube: My Account > Security > Generate token (type "Global analysis")
SONAR_TOKEN=
SONAR_DB_PASSWORD=change-me

# Docker Hub: Account settings > Personal access tokens (Read & Write)
DOCKERHUB_USER=
DOCKERHUB_TOKEN=

# Root password of the disposable MySQL started by each build
CI_DB_PASSWORD=change-me
